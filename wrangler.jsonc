{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prahra",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "routes": [
    { "pattern": "prahra.cz/*", "zone_name": "prahra.cz" },
    { "pattern": "www.prahra.cz/*", "zone_name": "prahra.cz" }
  ],
  "d1_databases": [
    {
      "binding": "prahra_db",
      "database_name": "prahra-db",
      "database_id": "1dd819b8-eeec-47ed-9177-1dbebae5f9c3",
      "remote": true
    }
  ]
}
